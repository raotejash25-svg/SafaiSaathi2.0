# Safai Saathi Environment Variables
# In production on Vercel, populate these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Note: If these keys are not set, Safai Saathi automatically runs in Zero-Setup Demo Mode
# with local simulated tracking, interactive mock state, and 1-click persona testing.
